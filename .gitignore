# ===========================================
# Docker & Containers
# ===========================================
*.log
.docker/

# ===========================================
# Certificados y Claves (CRÍTICO - NO SUBIR)  
# ===========================================
# Directorio completo de certificados
certs/
!certs/.gitkeep

# Claves PGP (SÚPER CRÍTICO - NO SUBIR)
pgp_keys/alice/alice_private.asc
pgp_keys/bob/bob_private.asc
pgp_keys/*/KEY_INFO.txt
*.asc
*.gpg

# Claves privadas y certificados SSL
*.key
*.crt
*.csr
*.pem
*.p12
*.pfx

# Archivos de CA
ca/certs/
ca/private/
ca/newcerts/
ca/crl/
ca/index.txt*
ca/serial*

# ===========================================
# Claves PGP/GPG (CRÍTICO - NO SUBIR)
# ===========================================
pgp_keys/
!pgp_keys/.gitkeep
*.asc
*.gpg
pubring.*
secring.*
trustdb.gpg
random_seed

# Directorios específicos de GPG
openpgp-revocs.d/
private-keys-v1.d/

# ===========================================
# Datos de Mail
# ===========================================
maildata/
!maildata/.gitkeep
*.mbox
*.eml

# ===========================================
# Logs y archivos temporales
# ===========================================
*.log
*.tmp
*.temp
logs/
tmp/

