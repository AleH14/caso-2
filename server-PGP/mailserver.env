# Configuración del servidor de correo Docker Mailserver
HOSTNAME=mail
DOMAINNAME=server.local
POSTMASTER_ADDRESS=postmaster@server.local

# TLS con certificados de tu CA
SSL_TYPE=manual
SSL_CERT_PATH=/etc/letsencrypt/live/server.local/mail-server.crt
SSL_KEY_PATH=/etc/letsencrypt/live/server.local/mail-server.key

# Opciones de servicios (deshabilitados para desarrollo)
ENABLE_SPAMASSASSIN=0
ENABLE_CLAMAV=0
ENABLE_FAIL2BAN=0
ENABLE_POSTGREY=0
ENABLE_MANAGESIEVE=1

# Configuración Docker
ONE_DIR=1
PERMIT_DOCKER=network

# Configuración de logs (opcional)
ENABLE_UPDATE_CHECK=0
SUPERVISOR_LOGLEVEL=debug
