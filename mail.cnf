[ req ]
default_bits = 2048
prompt = no
distinguished_name = req_distinguished_name
req_extensions = v3_req

[ req_distinguished_name ]
C=SV
ST=San Salvador
L=San Salvador
O=MiEmpresa
OU=IT
CN=mail.server.local

[ v3_req ]
basicConstraints = CA:FALSE
keyUsage = nonRepudiation, digitalSignature, keyEncipherment
subjectAltName = @alt_names

[ alt_names ]
DNS.1 = mail.server.local
DNS.2 = server.local
DNS.3 = localhost
DNS.4 = mail
IP.1 = 127.0.0.1
IP.2 = ::1